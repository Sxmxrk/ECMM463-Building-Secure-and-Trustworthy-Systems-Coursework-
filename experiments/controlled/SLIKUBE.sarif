              },
              "shortDescription": {
                "text": " Use securityContext while provisioning containers"
              }
            },
            {
              "id": "SLIKUBE_03",
              "help": {
                "text": "Deactivate hostIPC while specifying configurations in Kubernetes manifests"
              },
              "name": " Activation of hostIPC",
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": " Deactivate hostIPC while specifying configurations in Kubernetes manifests"
              },
