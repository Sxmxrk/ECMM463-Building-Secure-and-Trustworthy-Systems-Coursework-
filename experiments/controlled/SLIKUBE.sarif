            {
              "id": "SLIKUBE_06",
              "help": {
                "text": "Avoid misuse with CAP_SYS_ADMIN, and misuse with CAP_SYS_MODULE configurations"
              },
              "name": " Capability Misuse",
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Avoid misuse with CAP_SYS_ADMIN, and misuse with CAP_SYS_MODULE configurations"
              },
              "shortDescription": {
                "text": " Avoid misuse with CAP_SYS_ADMIN, and misuse with CAP_SYS_MODULE configurations"
              }
            },
            {
              "id": "SLIKUBE_07",
              "help": {
                "text": "Avoid mounting of the Docker socket path by using the /var/run/docker.sock configuration"
              },
              "name": " Docker Socket Mounting",
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Avoid mounting of the Docker socket path by using the /var/run/docker.sock configuration"
              },
              "shortDescription": {
                "text": " Avoid mounting of the Docker socket path by using the /var/run/docker.sock configuration"
              }
            },
            {
              "id": "SLIKUBE_08",
              "help": {
                "text": " Avoid allocating privileges for child processes within a container that are higher than that of the parent processes with allowPrivilegeEscaltion : true"
              },
              "name": " Escalated Privileges for Child Container Processes",
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": " Avoid allocating privileges for child processes within a container that are higher than that of the parent processes with allowPrivilegeEscaltion : true"
              },
              "shortDescription": {
                "text": " Avoid allocating privileges for child processes within a container that are higher than that of the parent processes with allowPrivilegeEscaltion : true"
              }
            },
            {
              "id": "SLIKUBE_09",
              "help": {
                "text": " Avoid providing hard-coded secrets. Do not provide (i) hard-coded usernames, (ii) hard-coded passwords, and (iii) hard-coded private tokens in Kubernetes manifests."
              },
              "name": " Hard-coded Secret",
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": " Avoid providing hard-coded secrets. Do not provide (i) hard-coded usernames, (ii) hard-coded passwords, and (iii) hard-coded private tokens in Kubernetes manifests."
              },
              "shortDescription": {
                "text": " Avoid providing hard-coded secrets. Do not provide (i) hard-coded usernames, (ii) hard-coded passwords, and (iii) hard-coded private tokens in Kubernetes manifests."
              }
            },
            {
              "id": "SLIKUBE_10",
